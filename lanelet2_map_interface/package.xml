<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lanelet2_map_interface</name>
  <version>1.0.0</version>
  <description>The lanelet2_map_interface-package provides a library that can be included in other modules that need access to a lanelet2 map.</description>
  <maintainer email="guido.kueppers@ika.rwth-aachen.de">Guido Küppers</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclcpp</depend>
  <depend>lanelet2_map_manager_ifs</depend>
  <depend>lanelet2_core</depend>
  <depend>lanelet2_io</depend>
  <depend>lanelet2_projection</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
