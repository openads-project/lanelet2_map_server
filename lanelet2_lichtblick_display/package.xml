<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>lanelet2_lichtblick_display</name>
  <version>1.0.0</version>
  <description>Visualizes Lanelet2 maps by converting lanelet elements into visualization markersv(marker arrays) suitable for Lichtblick</description>

  <maintainer email="silas.damaschke@ika.rwth-aachen.de">Silas Damaschke</maintainer>
  <author email="silas.damaschke@ika.rwth-aachen.de">Silas Damaschke</author>

  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>visualization_msgs</depend>
  <depend>lanelet2_map_interface</depend>
  <depend>lanelet2_traffic_rules</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
