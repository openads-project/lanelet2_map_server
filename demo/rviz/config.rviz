Panels:
  - Class: rviz_common/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Lanelet2Map1
      Splitter Ratio: 0.6646586060523987
    Tree Height: 1609
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
      - /Plan Route1
      - /Plan Route1/Action server1
    Name: Tool Properties
    Splitter Ratio: 0.5870130062103271
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: lanelet2_rviz_display/Lanelet2MapDisplay
      Enabled: true
      Fill Lanelets (Road):
        Road Color: 72; 72; 72
        Value: true
      Name: Lanelet2Map
      Name of lanelet2_map_server: /localization/lanelet2_map_server
      Show Map in 3D: false
      Value: true
      Visualize Areas:
        Area Color: 230; 127; 25
        Area Width: 0.30000001192092896
        Fill Areas: false
        Value: false
      Visualize Crosswalks:
        Crosswalk Color: 255; 255; 255
        Value: true
      Visualize Lanelet-IDs:
        Character Height: 1
        ID Color: 255; 255; 255
        Value: false
      Visualize Lanelet-Linestrings:
        LL Color Left: 255; 255; 255
        LL Color Right: 255; 255; 255
        Linestring Width: 0.10000000149011612
        Value: true
      Visualize Lanelet-Separators:
        Linestring Width: 0.20000000298023224
        Separators Color: 25; 25; 230
        Value: false
      Visualize Parking:
        Fill Parking: true
        Parking Color: 0; 179; 76
        Parking Width: 0.30000001192092896
        Value: false
      Visualize Sidewalks:
        Sidewalk Color: 191; 191; 191
        Value: true
      Visualize Stop lines:
        Stop Line Color: 255; 25; 25
        Stop Line Width: 0.20000000298023224
        Value: true
      Visualize Traffic Lights:
        Traffic Light Color: 102; 102; 102
        Traffic Light Height: 3
        Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
    - Action server:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning/lanelet2_route_planning/plan_route
      Class: route_planning_msgs/PlanRoute
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 7.1833176612854
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 152.62298583984375
      Y: 113.18091583251953
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 2086
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 3840
  X: 8960
  Y: 415
